<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <gazebo>
        <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
            <robotNamespace>/</robotNamespace>

            <!-- Wheel Information (The Kinematics) -->
            <!--A differential drive robot steers by rotating its left and right wheels at different speeds.
             Gazebo needs exact geometric data to translate your velocity commands into rotational wheel calculations.-->
            <left_joint>left_wheel_joint</left_joint>
            <right_joint>right_wheel_joint</right_joint>
            <wheel_separation>0.35</wheel_separation> // Calculated from the distance between the left and right wheels, check the URDF
            <wheel_radius>0.05</wheel_radius> 

            <!-- Limits -->
            <max_wheel_torque>100</max_wheel_torque>
            <max_wheel_acceleration>10</max_wheel_acceleration>

           <!-- Output Topics and Frames -->
            <topic>cmd_vel</topic>
            <odom_topic>odom</odom_topic>
            <frame_id>odom</frame_id>
            <child_frame_id>base_link</child_frame_id>
            
            <!-- TF Broadcasting -->
            <odom_publisher_frequency>30</odom_publisher_frequency>
        </plugin>



        <!-- Plugin 2: The Joint State Publisher (Extracts the wheel angles) -->
        <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
            <topic>joint_states</topic>
            <joint_name>left_wheel_joint</joint_name>
            <joint_name>right_wheel_joint</joint_name>
        </plugin>
    </gazebo>

</robot> 