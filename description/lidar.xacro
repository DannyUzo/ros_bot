<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" >

    <joint name="lidar_joint" type="fixed">
        <parent link="chassis"/>
        <child link="lidar_frame"/>
        <!-- <origin xyz="0 0 0" rpy="0 0 0"/> -->
        <origin xyz="0.1 0 0.175" rpy="0 0 0"/>
    </joint>
    
    <link name="lidar_frame">
        <visual>
            <geometry>
                <cylinder radius="0.05" length="0.04"/>
            </geometry>
            <material name="orange"/>
        </visual>
        <collision>
            <geometry>
                <cylinder radius="0.05" length="0.04"/>
            </geometry>
        </collision>
        <xacro:inertial_cylinder mass="0.1" length="0.04" radius="0.05">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_cylinder>
    </link>

    <gazebo reference="lidar_frame">
    <material>Gazebo/Orange</material>

    <sensor name="laser" type="gpu_lidar">
        <pose>0 0 0 0 0 0</pose> <!-- Origin of the virtual sensor is at the origin of the link -->
        <visualize>true</visualize>
        <update_rate>10</update_rate> <!-- 10 times per second -->
        
        <!-- Modern Replacements for the Legacy Plugin -->
        <topic>scan</topic> <!-- Tells Gazebo what internal topic to publish the data to. -->
        <gz_frame_id>lidar_frame</gz_frame_id> <!-- Binds the published sensor data to your physical TF frame -->
        
        <ray>
            <scan>
                <horizontal> <!-- Horizontal scan of the laser -->
                    <samples>360</samples>
                    <resolution>1.0</resolution> <!-- Angular Resolution, it defines the angular density of the laser beams. --> 
                    <min_angle>-3.14</min_angle> <!-- -3.14 rad = -180 degrees -->
                    <max_angle>3.14</max_angle>
                </horizontal>
            </scan>
            <range>
                <min>0.3</min> <!-- Blind spot. This represents a minimum detection range of 0.3 meters (30 centimeters).-->
                <max>12.0</max>
                <resolution>0.01</resolution> <!-- Distance Resolution, it defines the measurement precision of the sensor in meters.-->
            </range>
        </ray>
        <always_on>true</always_on>
    </sensor>
</gazebo>

</robot>