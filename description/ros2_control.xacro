<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    
    <ros2_control name="GazeboSimSystem" type="system">
        <hardware>
            <!-- The Modern Gazebo Hardware Bridge -->
            <plugin>gz_ros2_control/GazeboSimSystem</plugin>
        </hardware>

        <joint name="left_wheel_joint">
            <command_interface name="velocity"> <!-- Defines how we write to the motors -->
                <param name="min">-10.0</param>
                <param name="max">10.0</param>
            </command_interface>
            <state_interface name="position"/> <!-- Defines how we read data from the encoders-->
            <state_interface name="velocity"/>
            <!-- <state_interface name="effort"/> -->
        </joint>

        <joint name="right_wheel_joint">
             <command_interface name="velocity">
                <param name="min">-10.0</param>
                <param name="max">10.0</param>
            </command_interface>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
            <!-- <state_interface name="effort"/> -->
        </joint>
    </ros2_control>

    <!-- The single plugin that connects Gazebo to the ROS 2 Controller Manager -->
<gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
        <parameters>$(find ros_bot)/config/my_controllers.yaml</parameters>
    </plugin>
</gazebo>


    

</robot>